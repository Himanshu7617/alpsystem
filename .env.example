# Copy to .env. Host-side values; docker compose injects its own for containers.
DATABASE_URL="postgresql://adaptive_learning:adaptive_learning@127.0.0.1:54329/adaptive_learning?schema=public"
JWT_SECRET=dev-secret-change-me

# Which policy serves the next difficulty. "rule_improved" is the honest
# default: the ml arm is rebuilt against a real trained artifact in Phase 8.
ALP_POLICY=rule_improved

ML_SERVICE_URL=http://127.0.0.1:8000

# Research pipeline
# MLflow 3.15 retired the file store; sqlite keeps the same "one file, no
# server" decision. Browse with:
#   mlflow ui --backend-store-uri sqlite:///mlruns/mlflow.db
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
SEED=20260821
