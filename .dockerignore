# The build context is the repository root for every image here, and the
# repository carries 1.3 GB of archival corpora plus 296 MB of figures that no
# image copies. Without this file every build ships all of it to the daemon.

.git
mlruns
node_modules
backend/node_modules
**/__pycache__
**/*.pyc
.pytest_cache
.venv
venv

# Regenerated by `make fetch-data` / `make prep-data`; never read at serve time.
# data/items is the item bank and stays — the rule arms read it to band on
# difficulty.
data/raw
data/processed

# The quarantined pre-Phase-0 results. Read only by figure f04-07, offline.
artifacts-legacy-invalid

# Figures, reports and the research outputs are offline deliverables. Three
# things under artifacts/ are read at request time, so they are excluded from
# the exclusion: the models, the decision-explanation traces, and the Rasch
# item parameters.
artifacts/*
!artifacts/models
!artifacts/models/**
!artifacts/evaluation
!artifacts/evaluation/**
!artifacts/datasets
!artifacts/datasets/**
artifacts/evaluation/*
!artifacts/evaluation/decision-explanations.json
!artifacts/evaluation/validation-gate.json
artifacts/datasets/*
!artifacts/datasets/item-parameters-v1.csv
artifacts/models/rl/checkpoints

docs
