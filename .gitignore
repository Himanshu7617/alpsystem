.env
.env.local
.DS_Store
node_modules/
dist/
build/
coverage/
*.log
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# MLflow file backend: runs are regenerated by `make`, not committed
mlruns/*
!mlruns/.gitkeep

# Phase 3 downloads and derived tables are regenerated by `make fetch-data`
data/raw/
data/processed/
artifacts/datasets/sim-v2-*.parquet

# Phase 8 cell checkpoints: a resume aid, regenerated by `make eval-policies`
artifacts/evaluation/cells/
artifacts/evaluation/run-log.jsonl

# Derived, large, and regenerated by a make target (see BUILD.md rule 2):
# per-row prediction and decision tables, per-learner dumps, fitted tree
# models and PPO checkpoints. The JSON summaries and figures drawn from them
# are tracked.
artifacts/benchmarks/*-predictions.parquet
artifacts/datasets/logged-bandit-data.parquet
artifacts/evaluation/*.parquet
artifacts/evaluation/policy-per-learner-*.csv
artifacts/models/study1-*-lightgbm/
artifacts/models/rl/checkpoints/
